# Backup sidecar: runs backup.sh every BACKUP_INTERVAL seconds. UNTESTED image build.
FROM alpine:3.20
RUN apk add --no-cache bash coreutils curl findutils flock procps rsync sqlite tar zstd \
        restic rclone openssh-client postgresql16-client
COPY backup.sh restore.sh /usr/local/bin/
ENV DATA_DIR=/data STAGE_DIR=/backup/stage
CMD ["bash", "-c", "while true; do backup.sh || true; sleep \"${BACKUP_INTERVAL:-3600}\"; done"]
